{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/paawandesai/gh-nightshift/blob/main/nightshift/schema/config.schema.json",
  "title": "gh-nightshift config (.night-shift/config.yml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "lanes"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "main_branch": {
      "type": "string",
      "minLength": 1
    },
    "ci_workflow": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+\\.ya?ml$",
      "description": "File name of the CI workflow whose runs on main gate every lane."
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "fix_lane": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,30}$"
    },
    "timezone": {
      "type": "string"
    },
    "protected_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Added to the built-in list (.github/, .claude/, CLAUDE.md, AGENTS.md, .mcp.json, .night-shift/), never replacing it."
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "strict",
            "queue"
          ]
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ready": {
          "type": "string"
        },
        "blocked": {
          "type": "string"
        },
        "needs_human": {
          "type": "string"
        },
        "human": {
          "type": "string"
        },
        "proposed": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "in_progress": {
          "type": "string"
        },
        "night_log": {
          "type": "string"
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/$defs/model"
        },
        "escalate": {
          "$ref": "#/$defs/model"
        },
        "review": {
          "$ref": "#/$defs/model"
        },
        "planner": {
          "$ref": "#/$defs/model"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "infra_cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "stale_minutes": {
          "type": "integer",
          "minimum": 5
        },
        "max_turns": {
          "type": "integer",
          "minimum": 5,
          "maximum": 500
        },
        "max_needs_per_issue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "max_notes_per_issue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "auto_ready_needs": {
          "type": "boolean",
          "description": "false (default): a ticket an agent requests in another lane (`needs`) is filed as `proposed` and a person promotes it. true: it gets the ready label at once when it passes the ticket validator, so agents can queue work for each other with nobody in between. Never taken from an org-wide base config."
        }
      }
    },
    "planner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_tickets_per_run": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "refill_below": {
          "type": "integer",
          "minimum": 0
        },
        "id_prefixes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Z]{1,4}$"
          }
        },
        "human_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tickets touching these (e.g. contracts/) become human tickets."
        },
        "claude_token_secret": {
          "$ref": "#/$defs/secret",
          "description": "Claude token the planner uses (default: the first lane's)."
        },
        "schedule": {
          "type": "string",
          "description": "cron for auto-refill runs (default '17 * * * *'; only used when refill_below > 0)."
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "claude_token_secret"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,30}$"
          },
          "description": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claude_token_secret": {
            "$ref": "#/$defs/secret"
          },
          "agent_pat_secret": {
            "$ref": "#/$defs/secret"
          },
          "fallback_token_secret": {
            "$ref": "#/$defs/secret",
            "description": "Optional second Claude token (for example from the owner's second account). The agent job switches to it only when the first token cannot start a run (usage limit, expired or revoked token). The lane then receives three secrets."
          },
          "model": {
            "$ref": "#/$defs/model"
          },
          "escalate_model": {
            "$ref": "#/$defs/model"
          },
          "test_command": {
            "type": "string"
          },
          "budget_usd_per_night": {
            "type": "number",
            "minimum": 0,
            "description": "Optional nightly spend cap (API-equivalent USD, from the night log). The lane pauses for the rest of the night once reached. 0 or absent: no cap."
          },
          "postgres_image": {
            "type": "string",
            "description": "Start this Postgres image as a service in the lane's agent job (DATABASE_URL is set)."
          },
          "setup": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "commands": {
                "type": [
                  "string",
                  "array"
                ],
                "items": {
                  "type": "string"
                }
              },
              "action": {
                "type": "string",
                "pattern": "^\\./?[A-Za-z0-9._/-]+$",
                "description": "Local composite action directory, run only in this lane's agent job."
              }
            }
          }
        }
      }
    },
    "review_token_secret": {
      "$ref": "#/$defs/secret",
      "description": "Claude token for the review gate (default CLAUDE_TOKEN_REVIEW). Use someone other than the lane owners."
    },
    "ci_workflow_name": {
      "type": "string",
      "description": "The `name:` of the CI workflow (for workflow_run triggers; default read from the file, else CI)."
    },
    "bot_login": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+(\\[bot\\])?$",
      "description": "Login of the account that owns the PAT. stats and audit trust only its markers; default: whoever runs them."
    },
    "trusted_logins": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9-]+(\\[bot\\])?$"
      },
      "uniqueItems": true,
      "description": "Logins of per-contributor PATs (lanes[].agent_pat_secret). Their ns markers and PRs are trusted like the shared PAT's. Default: only the login of the PAT the job runs with."
    },
    "tool_ref": {
      "type": "string",
      "description": "gh-nightshift ref the caller workflows pin (default main; pin a tag or SHA)."
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "description": "Morning digest on the night-log issue (and an optional Slack/Discord webhook)",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "description": "cron, UTC; default 0 7 * * *"
        },
        "webhook_secret": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$",
          "description": "secret holding a Slack or Discord webhook URL"
        },
        "weekly_schedule": {
          "type": "string",
          "description": "cron (UTC) for the 7-day weekly report; default 0 8 * * 1, empty string turns it off"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "description": "Risk tiers (strict merge mode): which green agent PRs also need one human approval before the picker merges them",
      "properties": {
        "default": {
          "enum": [
            "auto",
            "approve"
          ]
        },
        "approve_labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approve_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auto_labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "codeowners": {
          "type": "boolean",
          "description": "PRs that touch files with CODEOWNERS owners need one of those owners' approval"
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "description": "How the PAT jobs authenticate: a PAT (default) or a GitHub App whose installation token is minted per job",
      "properties": {
        "mode": {
          "enum": [
            "pat",
            "app"
          ]
        },
        "app_id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "private_key_secret": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        }
      }
    },
    "extends": {
      "type": "string",
      "description": "owner/repo (e.g. your-org/.github) whose .night-shift/config.yml is the org-wide base; `gh nightshift config pull` copies it to .night-shift/base.yml"
    }
  },
  "$defs": {
    "secret": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]{0,99}$"
    },
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    }
  }
}
